# Neon PostgreSQL pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Generate a unique production value with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# Cloudinary article thumbnails
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-api-secret"
